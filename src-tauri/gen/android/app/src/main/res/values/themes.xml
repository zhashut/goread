<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.goread" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Make system bars transparent for edge-to-edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <!-- Ensure navigation bar icons are dark in light mode -->
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <!-- 必须为 false：该属性会让 DecorView 用固定的半透明黑色(#66000000)绘制状态栏背景，
             与 enableEdgeToEdge() 冲突，且 statusBarColor 无法覆盖它；透明状态栏统一由 enableEdgeToEdge() 实现 -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <!-- Draw behind system bars -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Light status bar (dark icons) for light theme；阅读页会由 StatusBarBridge 在运行时覆盖 -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!-- Handle display cutout -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>
</resources>
